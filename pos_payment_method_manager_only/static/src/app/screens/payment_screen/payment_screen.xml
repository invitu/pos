<templates id="template" xml:space="preserve">
    <t
        t-name="pos_payment_method_manager_only.PaymentScreenMethods"
        t-inherit="point_of_sale.PaymentScreenMethods"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute
                name="t-if"
            >!paymentMethod.manager_only or pos.get_cashier()._role === 'manager'</attribute>
        </xpath>
    </t>
</templates>
