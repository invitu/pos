<templates id="template" xml:space="preserve">
    <t
        t-name="pos_product_attribute_value_availability.RadioProductAttribute"
        t-inherit="point_of_sale.RadioProductAttribute"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('attribute-name-cell')]" position="attributes">
            <attribute
                name="t-att-class"
            >{'ptav-not-available': value.excluded or value.is_available === false}</attribute>
        </xpath>
    </t>
    <t
        t-name="pos_product_attribute_value_availability.PillsProductAttribute"
        t-inherit="point_of_sale.PillsProductAttribute"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('attribute-name-cell')]" position="attributes">
            <attribute
                name="t-att-class"
            >{'ptav-not-available': value.excluded or value.is_available === false}</attribute>
        </xpath>
    </t>
    <t
        t-name="pos_product_attribute_value_availability.SelectProductAttribute"
        t-inherit="point_of_sale.SelectProductAttribute"
        t-inherit-mode="extension"
    >
        <xpath expr="//option" position="attributes">
            <attribute
                name="t-att-class"
            >{'ptav-not-available': value.excluded or value.is_available === false}</attribute>
        </xpath>
    </t>
    <t
        t-name="pos_product_attribute_value_availability.ColorProductAttribute"
        t-inherit="point_of_sale.ColorProductAttribute"
        t-inherit-mode="extension"
    >
        <xpath expr="//label" position="attributes">
            <attribute
                name="t-att-class"
            >{'ptav-not-available': value.excluded or value.is_available === false}</attribute>
        </xpath>
    </t>
    <t
        t-name="pos_product_attribute_value_availability.MultiProductAttribute"
        t-inherit="point_of_sale.MultiProductAttribute"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[@t-as='value']" position="attributes">
            <attribute
                name="t-att-class"
            >{'ptav-not-available': value.is_available === false}</attribute>
        </xpath>
    </t>
</templates>
